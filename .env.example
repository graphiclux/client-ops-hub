# App
NEXTAUTH_URL=https://clients.graphiclux.com
NEXTAUTH_SECRET=replace_with_random_secret
MANAGER_RESTRICT_TO_ASSIGNED_CLIENTS=false

# Database
POSTGRES_USER=clientops
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=clientops
DATABASE_URL=postgresql://clientops:replace_with_strong_password@postgres:5432/clientops?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Encryption
MASTER_KEY=replace_with_32_bytes_base64
APP_ENCRYPTION_AAD=client-ops-hub
TWO_FACTOR_REMEMBER_DAYS=30

# Xero OAuth
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://clients.graphiclux.com/api/integrations/xero/callback

# Trello OAuth/API
TRELLO_CLIENT_ID=
TRELLO_CLIENT_SECRET=
TRELLO_API_KEY=
TRELLO_REDIRECT_URI=https://clients.graphiclux.com/settings/integrations/trello-callback

# Storage
FILE_STORAGE_PATH=/data/uploads

# Deployment
LETSENCRYPT_EMAIL=ops@graphiclux.com
INITIAL_ADMIN_EMAIL=you@graphiclux.com
INITIAL_ADMIN_PASSWORD=replace_with_strong_admin_password
